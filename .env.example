# 复制此文件为 .env 并填写你自己的配置
#
# 注意：这里只能放占位符，绝对不要把真实 API Key 提交到仓库！

# ---- LLM 配置（支持所有 OpenAI 兼容接口）----
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 以下均为可选，不填则使用代码里的默认值 ----

# 生成随机性
# LLM_TEMPERATURE=0.3
# 单次请求超时（秒）与自动重试次数
# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=2

# file_reader 允许访问的根目录，多个目录用分号分隔（Windows）
# 不设置时默认为「当前工作目录」
# ALLOWED_ROOTS=D:\code;D:\homework

# 文件读取上限
# MAX_FILE_BYTES=1048576
# MAX_FILE_CHARS=20000

# code_executor 执行限制
# EXEC_TIMEOUT_SECONDS=10
# EXEC_MAX_OUTPUT_CHARS=5000

# Agent 运行时
# AGENT_RECURSION_LIMIT=25
# AGENT_MAX_HISTORY_MESSAGES=40
# AGENT_ENABLE_CHECKPOINTER=1
